{
  "name": "ecobuddy-ai-backend",
  "version": "1.0.0",
  "description": "Express and MongoDB API for EcoBuddy AI carbon footprint tracking.",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
