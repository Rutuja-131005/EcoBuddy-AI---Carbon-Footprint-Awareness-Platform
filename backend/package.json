    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "isomorphic-dompurify": "^3.17.0",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "pdfkit": "^0.15.2",
    "xss": "^1.0.15",
    "xss-clean": "^0.1.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
